NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=fluide_prod
PGUSER=fluide_app
PGPASSWORD=replace-with-local-password
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_TTL_HOURS=12
CMS_MEDIA_DIR=media/uploads
CMS_MAX_UPLOAD_MB=12
YANDEX_CLIENT_ID=replace-with-yandex-client-id
YANDEX_CLIENT_SECRET=replace-with-yandex-client-secret
YANDEX_REDIRECT_URI=http://127.0.0.1:3000/api/auth/yandex/callback
VK_CLIENT_ID=54774890
VK_REDIRECT_URI=http://127.0.0.1:3000/api/auth/vk/callback
SMS_PROVIDER=console
# Для production: SMS_PROVIDER=smsru и ключ из кабинета SMS.RU
SMS_RU_API_KEY=
SMS_SENDER=
SMS_CODE_TTL_MINUTES=10
SMS_CODE_MAX_ATTEMPTS=5
SMS_RESEND_SECONDS=60
SMS_DAILY_PER_PHONE=5
SMS_DAILY_PER_IP=30
SMS_DAILY_GLOBAL=100
